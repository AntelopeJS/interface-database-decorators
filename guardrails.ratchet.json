{
  "pack": "0.2.17",
  "rules": {
    "anti-slop/no-known-value-widening": 2,
    "anti-slop/no-unknown-parameters": 8,
    "anti-slop/no-unknown-returns": 1,
    "anti-slop/no-unsafe-dictionary-type": 14,
    "anti-slop/require-safety-comment-for-type-assertion": 7,
    "typescript/no-unnecessary-type-parameters": 5,
