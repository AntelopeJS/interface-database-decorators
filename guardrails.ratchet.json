{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 9,
    "antelopejs/no-presence-only-type-guard": 2,
    "anti-slop/no-chained-type-assertions": 1,
    "anti-slop/no-known-value-widening": 2,
    "anti-slop/no-runtime-typeof": 1,
    "anti-slop/no-unknown-parameters": 8,
    "anti-slop/no-unknown-returns": 1,
    "anti-slop/no-unsafe-dictionary-type": 18,
    "anti-slop/require-safety-comment-for-type-assertion": 15,
    "typescript/no-unnecessary-type-parameters": 8,
    "typescript/no-unsafe-argument": 18,
    "typescript/no-unsafe-assignment": 16,
    "typescript/no-unsafe-return": 17
  },
  "oversizeFiles": {}
}
