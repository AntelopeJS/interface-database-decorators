{
  "name": "@antelopejs/interface-database-decorators",
  "version": "0.1.6",
  "description": "AntelopeJS interface for database schema decorators and model definitions",
  "keywords": [
    "antelopejs",
    "database",
    "decorators",
    "interface",
    "orm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/interface-database-decorators.git"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "common": [
        "dist/common.d.ts"
      ],
      "database": [
        "dist/database.d.ts"
      ],
      "model": [
        "dist/model.d.ts"
      ],
      "relation": [
        "dist/relation.d.ts"
      ],
      "schema": [
        "dist/schema.d.ts"
      ],
      "table": [
        "dist/table.d.ts"
      ],
      "modifiers/autodate": [
        "dist/modifiers/autodate.d.ts"
      ],
      "modifiers/common": [
        "dist/modifiers/common.d.ts"
      ],
      "modifiers/encryption": [
        "dist/modifiers/encryption.d.ts"
      ],
      "modifiers/hash": [
        "dist/modifiers/hash.d.ts"
      ],
      "modifiers/localization": [
        "dist/modifiers/localization.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./relation": {
      "types": "./dist/relation.d.ts",
      "default": "./dist/relation.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./modifiers/autodate": {
      "types": "./dist/modifiers/autodate.d.ts",
      "default": "./dist/modifiers/autodate.js"
    },
    "./modifiers/common": {
      "types": "./dist/modifiers/common.d.ts",
      "default": "./dist/modifiers/common.js"
    },
    "./modifiers/encryption": {
      "types": "./dist/modifiers/encryption.d.ts",
      "default": "./dist/modifiers/encryption.js"
    },
    "./modifiers/hash": {
      "types": "./dist/modifiers/hash.d.ts",
      "default": "./dist/modifiers/hash.js"
    },
    "./modifiers/localization": {
      "types": "./dist/modifiers/localization.d.ts",
      "default": "./dist/modifiers/localization.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "randomstring": "^1.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@antelopejs/interface-api": "^0.0.5",
    "@antelopejs/interface-core": "^0.0.5",
    "@antelopejs/interface-database": "^0.1.3",
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/randomstring": "^1.3.0",
    "@types/semver": "^7.7.1",
    "chai": "^4.5.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^10.4.3",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/interface-api": ">=0.0.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.0.3 <1.0.0",
    "@antelopejs/interface-database": ">=0.1.1 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "standalone": true,
    "test": "src/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
